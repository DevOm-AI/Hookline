# Production settings for docker-compose.prod.yml. See docs/deploy.md.
# Copy to .env on the server and fill in every REPLACE_ME: cp .env.production.example .env
# Never commit the real .env.

# Hookline refuses to start in production with DEBUG=true, a missing or local dev
# API_KEY_HASH, or any ALLOWED_INTERNAL_HOSTS.
ENVIRONMENT=production
DEBUG=false

# The hostname Caddy gets a certificate for. It must resolve to this server: a domain you
# own, or the server's IP with dashes on sslip.io (1.2.3.4 -> 1-2-3-4.sslip.io).
DOMAIN=REPLACE_ME.sslip.io

POSTGRES_USER=hookline
# Required. Generate with: openssl rand -hex 32 (hex, so it needs no escaping in the URL).
POSTGRES_PASSWORD=
POSTGRES_DB=hookline

# Hostnames are the docker compose service names. ${POSTGRES_PASSWORD} is filled in from
# the line above, so the password is written only once.
DATABASE_URL=postgresql+psycopg://hookline:${POSTGRES_PASSWORD}@postgres:5432/hookline
REDIS_URL=redis://redis:6379/0

# Empty in production: no endpoint may resolve to a private address.
ALLOWED_INTERNAL_HOSTS=

# SHA-256 of the API key; the key itself is never stored. Required: generate a pair with
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api python -m app.core.security
# and put its API_KEY_HASH=... line here.
# API_KEY_HASH=

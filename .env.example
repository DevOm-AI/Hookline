# Copy to .env and adjust: cp .env.example .env
# Never commit the real .env.

ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=hookline
POSTGRES_PASSWORD=hookline
POSTGRES_DB=hookline

# Hostnames are the docker compose service names.
DATABASE_URL=postgresql+psycopg://hookline:hookline@postgres:5432/hookline
REDIS_URL=redis://redis:6379/0
# Defaults to REDIS_URL when unset.
# CELERY_BROKER_URL=

# Host ports for reaching Postgres/Redis from your machine (e.g. local pytest).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

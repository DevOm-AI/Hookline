# Copy to .env and adjust: cp .env.example .env
# Never commit the real .env.

ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=hookline
POSTGRES_PASSWORD=hookline
POSTGRES_DB=hookline

# Hostnames are the docker compose service names.
DATABASE_URL=postgresql+psycopg://hookline:hookline@postgres:5432/hookline
REDIS_URL=redis://redis:6379/0
# Defaults to REDIS_URL when unset.
# CELERY_BROKER_URL=

# Endpoint hostnames allowed to resolve to private addresses (comma-separated).
# LOCAL ONLY: lets workers reach the mock receiver at http://receiver:9000/webhook.
ALLOWED_INTERNAL_HOSTS=receiver

# SHA-256 of the API key; the key itself is never stored.
# LOCAL ONLY: this is the hash of `hk_local_dev_key`. Generate a real pair for any
# deployed environment with: uv run python -m app.core.security
API_KEY_HASH=b47bc499a654a925df47dcf5caaaec54b17c1947d18acd2f552e5762d2789ed1

# Host ports for reaching Postgres/Redis from your machine (e.g. local pytest).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RECEIVER_HOST_PORT=9000
